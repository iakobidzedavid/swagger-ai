# ============================================================================
# PRODUCTION ENV VARS (Vercel / secrets.json)
# ============================================================================
# All real credentials are managed via Vercel environment variables.
# This file contains ONLY placeholders for documentation.
#
# DO NOT commit real secret values here. Real production secrets are:
# - Stored in Vercel project settings / Environment Variables
# - Injected at runtime during deploy
# - Read via process.env.* in server-side code
#
# To add a secret to Vercel:
# 1. Go to vercel.com → Project Settings → Environment Variables
# 2. Add the variable name and value
# 3. Redeploy the project (secrets auto-inject on build)
# ============================================================================

# Supabase — Database & Auth
# Obtain from: Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Brandfetch API Key — optional, unlocks richer brand detection across the entire platform
# Obtain from: https://brandfetch.com/ (free tier: 1000 requests/month)
# - When SET: brand detection uses Brandfetch API for accurate logos + company metadata + official brand colors
# - When UNSET: system gracefully falls back to keyless mode (Google favicon + HTML theme-color meta tag extraction)
#
# Keyless fallback is reliable for ~90% of domains but slower (~3-5s) and may miss recently rebranded companies.
# No code changes needed when the key is added — brand detection automatically improves.
BRANDFETCH_API_KEY=<your-brandfetch-api-key>

# Printify Integration (optional)
# Obtain from: https://printify.com/ → Account Settings → API Token
# Used for product mockup generation and order management
PRINTIFY_API_KEY=<your-printify-api-key>
PRINTIFY_ADMIN_SECRET=<your-printify-admin-secret>
PRINTIFY_OAUTH_CLIENT_ID=<your-printify-oauth-client-id>
PRINTIFY_OAUTH_CLIENT_SECRET=<your-printify-oauth-client-secret>

# Application URLs
# Set to your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_VERCEL_URL=your-app.vercel.app
